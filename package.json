{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Atlas Nx monorepo for a multi-tenant retail and point-of-sale platform.",
  "keywords": [
    "atlas",
    "store-management-system",
    "point-of-sale",
    "nx-monorepo",
    "nuxt",
    "vue",
    "rust",
    "axum",
    "postgresql",
    "cloudflare",
    "railway",
    "multi-tenant"
  ],
  "author": "Zunetra Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olorunshogo/Atlas-sms.git"
  },
  "bugs": {
    "url": "https://github.com/Olorunshogo/Atlas-sms/issues"
  },
  "homepage": "https://github.com/Olorunshogo/Atlas-sms#readme",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "test": "nx run-many -t test",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss,yml,yaml}\"",
    "dev:landing": "nx dev landing-page",
    "build:landing": "nx build landing-page",
    "preview:landing": "nx preview landing-page",
    "cf:project:create:landing:test": "pnpm --filter landing-page run cf:project:create:test",
    "cf:project:create:landing:prod": "pnpm --filter landing-page run cf:project:create:prod",
    "deploy:landing:test": "pnpm --filter landing-page run deploy:test",
    "deploy:landing:prod": "pnpm --filter landing-page run deploy:prod",
    "dev:web": "nx dev atlas-web",
    "build:web": "nx build atlas-web",
    "preview:web": "nx preview atlas-web",
    "cf:project:create:web:test": "pnpm --filter atlas-web run cf:project:create:test",
    "cf:project:create:web:prod": "pnpm --filter atlas-web run cf:project:create:prod",
    "deploy:web:test": "pnpm --filter atlas-web run deploy:test",
    "deploy:web:prod": "pnpm --filter atlas-web run deploy:prod",
    "dev:mobile": "nx dev atlas-mobile",
    "build:mobile": "nx build atlas-mobile",
    "preview:mobile": "nx preview atlas-mobile",
    "dev:backend": "nx serve atlas-backend",
    "build:backend": "nx build atlas-backend",
    "test:backend": "nx test atlas-backend",
    "lint:backend": "nx lint atlas-backend",
    "dev:all": "nx run-many -t dev serve",
    "build:all": "nx run-many -t build",
    "build:ui-core": "pnpm --filter @atlas/ui-core build",
    "watch:ui-core": "pnpm --filter @atlas/ui-core watch",
    "build:ui-web": "pnpm --filter @atlas/ui-web build",
    "watch:ui-web": "pnpm --filter @atlas/ui-web watch",
    "build:ui-app": "pnpm --filter @atlas/ui-app build",
    "watch:ui-app": "pnpm --filter @atlas/ui-app watch",
    "build:ui": "pnpm --filter @atlas/ui-core --filter @atlas/ui-web --filter @atlas/ui-app build",
    "storybook:ui-core": "nx storybook @atlas/ui-core",
    "build-storybook:ui-core": "nx build-storybook @atlas/ui-core",
    "fix:lockfile": "pnpm clean --lockfile && pnpm install",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "cd apps/atlas-backend && sqlx migrate run",
    "db:migrate:revert": "cd apps/atlas-backend && sqlx migrate revert"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.1.1",
    "@nx/eslint-plugin": "22.1.1",
    "@nx/js": "22.1.1",
    "@nx/node": "22.1.1",
    "@nx/storybook": "22.1.1",
    "@nx/vite": "22.1.1",
    "@nx/vitest": "22.1.1",
    "@nx/web": "22.1.1",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.15.13",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "20.19.9",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "10.9.2",
    "husky": "^9.1.7",
    "jsdom": "~22.1.0",
    "lint-staged": "^16.2.7",
    "nx": "22.1.1",
    "postcss": "^8.5.6",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "storybook": "10.0.8",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.3.0",
    "tsup": "^6.7.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^4.0.0",
    "vue-eslint-parser": "10.4.1"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "wrangler": "^4.67.0"
  },
  "validate-branch-name": {
    "pattern": "^(main|develop|live)$|^(feature|fix|refactor|hotfix|release|conflict|chore)/.*$",
    "errorMsg": "Branch name structure: <type>/<description>\nAllowed prefixes: feature, fix, refactor, hotfix, release, conflict, chore"
  }
}
