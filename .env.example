# Atlas environment template.
#
# Copy to .env and adjust. .env is gitignored and must never be committed:
# it holds a real database role and third-party provider keys.
#
#   cp .env.example .env
#
# Values below are safe local-development defaults. Every secret marked
# CHANGE IN PRODUCTION is a placeholder that must be replaced with a real
# generated secret before any deployment.
#
# PLACEHOLDER CONVENTION
#
# Secrets here are not blank. Each carries a fake value shaped like the real
# thing, so you can tell at a glance what the provider expects: the prefix,
# the character set, and the length. A blank tells you none of that and
# leaves you guessing whether a key is 32 or 64 characters.
#
# Every placeholder contains REPLACE_ME. Nothing containing REPLACE_ME is a
# real credential, and any provider will reject it. Grep for it before
# deploying anywhere:
#
#   grep -rn REPLACE_ME .env
#
# The shape hints are accurate to each provider's real format. Where a value
# is a fixed length, the placeholder is that length, so a key that does not
# fit is visibly wrong before you ever make a request.

# === Runtime

NODE_ENV=development
RUST_LOG=atlas_backend=debug,tower_http=debug,sqlx=warn

# Port the Rust backend binds. docker-compose publishes the same port, and
# ATLAS_API_BASE below must agree with it.
PORT=5754

# === Database
#
# IMPORTANT: connect as atlas_api, NOT as the postgres superuser.
# A superuser bypasses Row Level Security entirely, which would silently
# disable every tenant isolation policy in the schema. If you point this at
# a superuser, cross-tenant queries will succeed and you will not find out
# until production.
#
# Two modes, deliberately on different ports so they coexist:
#
#   pnpm nx dev atlas-backend      -> your own local Postgres, port 5432
#   pnpm nx docker atlas-backend   -> container Postgres, host port 5433
#
# The value below is for `nx dev`. The docker-compose backend service
# overrides DATABASE_URL with the container-network address, so you do not
# need to edit this when switching modes.
#
# For `nx dev` against your own Postgres, create the role once:
#
#   CREATE ROLE atlas_api LOGIN PASSWORD 'atlas_api_dev';
#   GRANT CONNECT ON DATABASE atlas TO atlas_api;
#
# The RLS migration grants it the atlas_app privilege role automatically.

DATABASE_URL=postgres://atlas_api:atlas_api_dev@localhost:5432/atlas

# Superuser connection, used only by `sqlx migrate run`. Migrations create
# roles and policies, which the application role is not permitted to do.
DATABASE_ADMIN_URL=postgres://atlas:atlas@localhost:5432/atlas

# === Redis
# Cache plus the apalis job queue. Running in docker-compose, not yet read
# by application code.

REDIS_URL=redis://localhost:6379

# === Auth
#
# Not yet consumed: the auth module is unbuilt. Present so the first
# handler does not need an env change.
#
# Generate a real one with: openssl rand -base64 48
# CHANGE IN PRODUCTION.

JWT_SECRET=dev-only-insecure-change-me-before-any-deployment
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies are host-only by design. No Domain attribute is set. Do not add
# one: Atlas has no per-store subdomain, and a shared Domain would leak a
# session across hosts.
COOKIE_SECURE=false

# === Frontend

# Where atlas-web's Nitro proxy forwards API calls. Must match ATLAS_PORT.
ATLAS_API_BASE=http://localhost:5755
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Unused by the API today. Kept so a future custom host has one place to set it.
# Atlas does not hang stores off subdomains.
ATLAS_ROOT_DOMAIN=localhost

# === Providers
#
# Every provider sits behind a trait (PaymentProvider, NotificationProvider,
# StorageProvider, EmailProvider). Handlers never import a provider
# directly, so switching one is a config change rather than a rewrite.
#
# The adapters are not wired yet, so in your own .env these can stay blank.
# They are shaped placeholders here only to document the expected format.

# Paystack. Test keys are sk_test_/pk_test_ followed by 40 hex characters;
# live keys use sk_live_/pk_live_ and are otherwise identical in shape.
# Never put a live key in a file that is not the production secret store.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME_40hex_0123456789abcdef0123456
PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_ME_40hex_0123456789abcdef0123456
# Paystack signs webhooks with your secret key. This is the value the
# handler HMACs the request body against before trusting any payload.
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME_32_char_webhook_secret

# Termii. API key is a long opaque token, roughly 60 characters.
# Sender ID is the name that appears on the recipient's handset: max 11
# characters, alphanumeric, and must be pre-registered with Termii.
NOTIFICATION_PROVIDER=termii
TERMII_API_KEY=TLREPLACE_ME_termii_api_key_approx_60_chars_0123456789abcd
TERMII_SENDER_ID=Atlas

# SMTP. Username is often literally "apikey" for transactional providers
# such as SendGrid, with the API key as the password.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.REPLACE_ME.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME_smtp_username_or_apikey
SMTP_PASSWORD=REPLACE_ME_smtp_password_or_api_key
EMAIL_FROM=no-reply@atlas.com

# Cloudflare R2. Account ID and access key ID are both 32 hex characters;
# the secret access key is 64 hex characters. If yours is a different
# length, you have copied the wrong field out of the dashboard.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=REPLACE_ME_32hex_0123456789abcde
R2_ACCESS_KEY_ID=REPLACE_ME_32hex_0123456789abcde
R2_SECRET_ACCESS_KEY=REPLACE_ME_64hex_0123456789abcdef0123456789abcdef0123456789abcde
R2_BUCKET=atlas-uploads-dev
R2_PUBLIC_URL=https://cdn.REPLACE_ME.example.com

# === Locale defaults
#
# The single place Nigerian defaults live. Formatters take locale and
# currency explicitly rather than assuming, so these are the fallback, not
# a hardcoded assumption. Tenants override per row.

DEFAULT_COUNTRY=NG
DEFAULT_LOCALE=en-NG
DEFAULT_CURRENCY=NGN
DEFAULT_TIMEZONE=Africa/Lagos

# === Cloudflare tunnel
#
# Optional. Only needed to expose a local backend publicly, for testing a
# provider webhook against your machine.
#
# The token is a long base64 string, typically 180 to 220 characters, copied
# whole from the Cloudflare Zero Trust dashboard when you create a tunnel.
# It is a single opaque blob: if yours contains a newline, the copy broke.
#
# cloudflared sits behind a compose profile, so it is skipped entirely
# unless you ask for it:
#
#   docker compose --profile tunnel up
#
# Leaving the placeholder here is safe. The service does not start without
# the profile, so an unusable token is never read.

CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME_base64_tunnel_token_approx_200_chars_eyJhIjoiMDEyMzQ1Njc4OWFiY2RlZiIsInQiOiIwMTIzNDU2Ny04OWFiLWNkZWYtMDEyMy00NTY3ODlhYmNkZWYiLCJzIjoiUkVQTEFDRV9NRV9iYXNlNjRfc2VjcmV0X3ZhbHVlIn0

# === Atlas (atlas-backend)
#
# Atlas Postgres, see docker-compose.atlas.yml. Same RLS-bypass warning as
# above: connect as
# atlas_api, never the superuser, or Row Level Security is bypassed
# entirely. Tables live in the `atlas` schema, not `public`, as a second
# layer of separation on top of the separate server.
#
# Two modes, same pattern as atlas-backend:
#
#   pnpm nx dev atlas-backend      -> your own local Postgres, port 5432
#   pnpm nx docker atlas-backend   -> container Postgres, host port 5434
#
# For `nx dev` against your own Postgres, create the role and schema once:
#
#   CREATE ROLE atlas_api LOGIN PASSWORD 'atlas_api_dev';
#   GRANT CONNECT ON DATABASE atlas TO atlas_api;
#
# The RLS migration grants it the atlas_app privilege role automatically.

ATLAS_PORT=5755
# Port 5434, not 5432: docker-compose.atlas.yml deliberately maps Atlas's
# own Postgres there, distinct from docker-compose.yml's 5433 and a developer's own
# native Postgres on 5432, so all three can run at once. This is the
# host-side address (`nx dev`, `sqlx migrate run`) - inside the
# atlas-backend container itself, docker-compose.atlas.yml overrides this
# with the compose-network hostname (`postgres:5432`) instead.
ATLAS_DATABASE_URL=postgres://atlas_api:atlas_api_dev@localhost:5434/atlas

# Superuser connection, used only by `sqlx migrate run` (migrations create
# roles/policies, which the application role is not permitted to do) -
# atlas-backend's project.json passes this explicitly via --database-url,
# since sqlx-cli only reads a plain DATABASE_URL by default and that name
# is reserved for atlas-backend in this shared .env file.
#
# `?options=-c search_path=public` is load-bearing, not decoration: the
# superuser role is named `atlas`, same as the `atlas` schema migration
# 0001 creates. Postgres's default search_path is `"$user", public`, so
# once that schema exists, `$user` resolves to it first - sqlx-cli's own
# unqualified `_sqlx_migrations` tracking table would then get created
# inside the `atlas` schema instead of `public` (where its real history
# already lives), lose track of every migration already applied, and
# fail re-running migration 2+ against tables that already exist. Pinning
# search_path here makes tracking-table resolution deterministic
# regardless of which schemas happen to exist when this runs.
ATLAS_DATABASE_ADMIN_URL=postgres://atlas:atlas@localhost:5434/atlas?options=-c%20search_path%3Dpublic

# Signs/verifies the access token issued by POST /api/v1/auth/login.
# Generate a real one for anything beyond local dev:
#   openssl rand -hex 32
ATLAS_JWT_SECRET=atlas_dev_jwt_secret_change_me
