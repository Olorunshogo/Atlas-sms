{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.vue",
    "src/**/*.test.ts",
    "src/**/*.test.vue",
    "src/**/*.stories.ts"
  ]
}
