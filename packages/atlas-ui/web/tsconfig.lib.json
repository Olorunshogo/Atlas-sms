{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    /**
     * Override the base path alias for @atlas/ui-core: ui-web only
     * re-exports it, so its own isolated declaration build must resolve it
     * as a real package (via node_modules -> package.json "types") rather
     * than reaching into ui-core's source, which sits outside this
     * project's file list and fails TS6307/TS6059 otherwise.
     */
    "paths": {}
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.vue",
    "src/**/*.test.ts",
    "src/**/*.test.vue"
  ]
}
